# Server Configuration
PORT=8000
# Bind address. 0.0.0.0 serves every interface; an SDK-spawned server sets
# 127.0.0.1 so nothing off the machine can reach it
HOST=0.0.0.0

# Logging
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Options: json, text
LOG_FORMAT=json

# Redis Cache (optional)
# REDIS_URL=redis://localhost:6379

# Rate Limiting
# Requests per minute, applied independently per client IP (default: 600 = 10 req/sec)
RATE_LIMIT_PER_MINUTE=600

# API Defaults
DEFAULT_INTERVAL=1d    # Options: 1m, 5m, 15m, 30m, 1h, 1d, 1wk, 1mo, 3mo
DEFAULT_RANGE=1mo      # Options: 1d, 5d, 1mo, 3mo, 6mo, 1y, 2y, 5y, 10y, ytd, max

# Default Query Limits
RECOMMENDATIONS_LIMIT=5
SEARCH_HITS=10
SCREENERS_COUNT=25

# SEC EDGAR Integration (optional)
# Contact email required by SEC - included in User-Agent header
# Leave commented out to disable EDGAR endpoints
# EDGAR_EMAIL=user@example.com

# FRED API Integration (optional)
# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
# Leave commented out to disable /v2/fred/* endpoints
# Note: If running a public server, your terms of use must state that users are bound
# by the FRED API Terms of Use: https://fred.stlouisfed.org/docs/api/terms_of_use.html
# FRED_API_KEY=your_fred_api_key_here

# Market Data Providers (all optional)
# Each key enables that provider; without one, requests fall back to the
# providers that need no credentials

# Polygon.io - https://polygon.io/dashboard/api-keys
# POLYGON_API_KEY=your_polygon_api_key_here

# Financial Modeling Prep - https://site.financialmodelingprep.com/developer/docs
# FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage - https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# US Bureau of Labor Statistics - https://data.bls.gov/registrationEngine/
# Raises the request quota; the BLS API also works unregistered
# BLS_API_KEY=your_bls_api_key_here

# OpenFIGI - https://www.openfigi.com/api
# Raises the rate limit on symbol lookups; works unregistered
# OPENFIGI_API_KEY=your_openfigi_api_key_here
