# Project-specific ignores
/*.zip
*.bak
*.orig
tmp/
trash/
attic/
.kash/
.claude/
IDEAS.md
*.py
# v1 is the one Python codebase that IS tracked — carve it out of the *.py ignore
!v1/src/**/*.py
!v1/tests/**/*.py
# So is the generated Python SDK: it is a published artifact, and the blanket
# *.py above was quietly keeping its sources out of the repo while its
# README and pyproject.toml went in.
!sdks/python/src/**/*.py
!sdks/python/hatch_build.py
flamegraph.svg
*.data
/CLAUDE.md
/.cargo/

# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Valgrind core dumps (the soothfast gate's callgrind fallback drops these
# in the repo root when a measured run crashes)
vgcore.*

# Rustfmt / clippy
.clippy.toml

# Test coverage
*.profraw
*.profdata
tarpaulin-report.html
cobertura.xml
lcov.info

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log

# Documentation build
/site/
/book/
docs/_build/

# Environment variables
*.env
!*.env.template
.env.local
.env.*.local

# Nginx (SSL certs are sensitive)
nginx/certs/

# Caddy data (auto-generated certs and config)
caddy-data/
caddy-config/

# V1 Python artifacts
v1/.venv/
v1/htmlcov/
v1/*.egg-info/
v1/__pycache__/
v1/.pytest_cache/

# Legacy Python artifacts at root
/.venv/
/htmlcov/
/.pytest_cache/
/.ruff_cache/

# Python bytecode anywhere (generated SDK smoke runs, tooling)
__pycache__/
*.pyc

# Generated SDK build artifacts (the sources ARE committed; builds are not)
sdks/python/dist/
sdks/python/.venv/
sdks/python/uv.lock
sdks/python/.mypy_cache/
sdks/typescript/node_modules/
sdks/typescript/package-lock.json
sdks/typescript/dist/
# Server binaries `sdk build` stages for publishing: the manifests around
# them are committed, the binaries never are.
sdks/typescript/platforms/*/bin/
sdks/python/src/finance_query/bin/

# OS files
.DS_Store
Thumbs.db

# superpowers workflow artifacts (specs, plans, SDD ledger — local tooling, not docs)
docs/superpowers/
.superpowers/

# soothfast local measurement state (baselines, worktrees, triage) — except
# the trend history, which is meant to accumulate across commits. A directory
# pattern can't be un-ignored file-by-file, so this ignores direct children
# instead of the directory itself.
.soothfast/*
!.soothfast/trend.jsonl

# Generated doc pages — regenerated by `make docs-pages`, not committed
# (mirrors soothfast's own .gitignore; llms.txt at repo root is checked in
# so agents see it without a build step).
/docs/reference/
/docs/perf/
/docs/coverage.md
/docs/llms.txt
/docs/server/finance-query-server.md
/docs/server/finance-query-mcp.md
/docs/server/api/
